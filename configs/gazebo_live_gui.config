<?xml version="1.0"?>
<!-- Read-only scene viewer: the RGB runner alone owns world stepping. -->
<dialog name="quick_start" show_again="false"/>
<window>
  <width>1100</width>
  <height>850</height>
  <dialog_on_exit>false</dialog_on_exit>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>TopoNav - Live Gazebo RGB navigation</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>1 1 1</ambient_light>
  <background_color>0.7 0.75 0.8</background_color>
  <camera_pose>1.5 -3 8 0 1.05 1.57079632679</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">floating</property>
    <property type="double" key="width">5</property>
    <property type="double" key="height">5</property>
  </gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">floating</property>
    <property type="double" key="width">5</property>
    <property type="double" key="height">5</property>
  </gz-gui>
</plugin>
