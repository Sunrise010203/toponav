{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Independent physical-channel inventory and optional simulator geometry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "exit_direction_frame",
    "nodes",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "exit_direction_frame": {
      "const": "map_xy_east_north"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "source",
          "target",
          "bidirectional",
          "source_direction",
          "target_direction"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "bidirectional": {
            "const": true
          },
          "source_direction": {
            "enum": [
              "east",
              "north",
              "west",
              "south"
            ]
          },
          "target_direction": {
            "enum": [
              "east",
              "north",
              "west",
              "south"
            ]
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units"
      ],
      "properties": {
        "units": {
          "const": "metre"
        },
        "coordinate_system": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "origin_node": {
              "type": "string",
              "minLength": 1
            },
            "x_positive": {
              "const": "east"
            },
            "y_positive": {
              "const": "north"
            },
            "heading_unit": {
              "const": "degree"
            },
            "heading_zero": {
              "const": "east"
            },
            "heading_positive": {
              "const": "counterclockwise"
            }
          }
        },
        "bounds_m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x_min",
            "x_max",
            "y_min",
            "y_max"
          ],
          "properties": {
            "x_min": {
              "type": "number"
            },
            "x_max": {
              "type": "number"
            },
            "y_min": {
              "type": "number"
            },
            "y_max": {
              "type": "number"
            }
          }
        },
        "node_positions_m": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "node_annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "channel_dimensions_m": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "length",
              "width"
            ],
            "properties": {
              "length": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "goal_acceptance_radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reference_task": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_node",
                "goal_node"
              ],
              "properties": {
                "start_node": {
                  "type": "string",
                  "minLength": 1
                },
                "goal_node": {
                  "type": "string",
                  "minLength": 1
                },
                "initial_heading_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                }
              }
            },
            "reference_routes": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
