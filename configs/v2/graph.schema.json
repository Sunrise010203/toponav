{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Map-independent orthogonal bidirectional topology v2",
  "description": "Format only; ID references, reciprocal connections, approved physical channels and task reachability are semantic checks, not fixed map constants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "directed",
    "exit_direction_frame",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "directed": {
      "const": false
    },
    "exit_direction_frame": {
      "const": "map_xy_east_north"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_node",
        "goal_node"
      ],
      "properties": {
        "start_node": {
          "type": "string",
          "minLength": 1
        },
        "goal_node": {
          "type": "string",
          "minLength": 1
        },
        "initial_heading_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_type",
          "neighbors",
          "exits"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_type": {
            "enum": [
              "entrance",
              "intersection",
              "corner",
              "corridor",
              "dead_end"
            ]
          },
          "neighbors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exits": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "neighbor_id",
                "channel_id",
                "direction"
              ],
              "properties": {
                "neighbor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "channel_id": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "east",
                    "north",
                    "west",
                    "south"
                  ]
                }
              }
            }
          },
          "reference_images": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "source",
          "target",
          "bidirectional",
          "enabled"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "bidirectional": {
            "const": true
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
