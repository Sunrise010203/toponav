{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Six-node indoor topology configuration (scene-specific)",
  "description": "Structure and scene-authorized endpoints; jq checks reciprocity, node uniqueness, edge consistency and route reachability separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "directed",
    "start_node",
    "goal_node",
    "action_semantics",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scene_id": {
      "const": "six_node_indoor_v1"
    },
    "directed": {
      "const": false
    },
    "start_node": {
      "enum": [
        "N01",
        "N02",
        "N03",
        "N04",
        "N05",
        "N06"
      ]
    },
    "goal_node": {
      "enum": [
        "N01",
        "N02",
        "N03",
        "N04",
        "N05",
        "N06"
      ]
    },
    "action_semantics": {
      "const": "absolute_exit_direction"
    },
    "nodes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "label",
          "node_type",
          "position_m",
          "neighbors",
          "actions",
          "reference_images"
        ],
        "properties": {
          "node_id": {
            "enum": [
              "N01",
              "N02",
              "N03",
              "N04",
              "N05",
              "N06"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "node_type": {
            "enum": [
              "entrance",
              "intersection",
              "corner",
              "goal"
            ]
          },
          "position_m": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "neighbors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "N01",
                "N02",
                "N03",
                "N04",
                "N05",
                "N06"
              ]
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "enum": [
                "north",
                "south",
                "east",
                "west"
              ]
            }
          },
          "reference_images": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "node_id": {
                  "const": "N01"
                }
              }
            },
            "then": {
              "properties": {
                "neighbors": {
                  "items": {
                    "enum": [
                      "N02"
                    ]
                  }
                },
                "position_m": {
                  "const": [
                    0,
                    0
                  ]
                },
                "node_type": {
                  "const": "entrance"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "node_id": {
                  "const": "N02"
                }
              }
            },
            "then": {
              "properties": {
                "neighbors": {
                  "items": {
                    "enum": [
                      "N01",
                      "N03",
                      "N05"
                    ]
                  }
                },
                "position_m": {
                  "const": [
                    2,
                    0
                  ]
                },
                "node_type": {
                  "const": "intersection"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "node_id": {
                  "const": "N03"
                }
              }
            },
            "then": {
              "properties": {
                "neighbors": {
                  "items": {
                    "enum": [
                      "N02",
                      "N04"
                    ]
                  }
                },
                "position_m": {
                  "const": [
                    4,
                    0
                  ]
                },
                "node_type": {
                  "const": "corner"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "node_id": {
                  "const": "N04"
                }
              }
            },
            "then": {
              "properties": {
                "neighbors": {
                  "items": {
                    "enum": [
                      "N03",
                      "N05",
                      "N06"
                    ]
                  }
                },
                "position_m": {
                  "const": [
                    4,
                    2
                  ]
                },
                "node_type": {
                  "const": "intersection"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "node_id": {
                  "const": "N05"
                }
              }
            },
            "then": {
              "properties": {
                "neighbors": {
                  "items": {
                    "enum": [
                      "N02",
                      "N04"
                    ]
                  }
                },
                "position_m": {
                  "const": [
                    2,
                    2
                  ]
                },
                "node_type": {
                  "const": "corner"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "node_id": {
                  "const": "N06"
                }
              }
            },
            "then": {
              "properties": {
                "neighbors": {
                  "items": {
                    "enum": [
                      "N04"
                    ]
                  }
                },
                "position_m": {
                  "const": [
                    6,
                    2
                  ]
                },
                "node_type": {
                  "const": "goal"
                }
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "source",
          "target",
          "length_m",
          "width_m",
          "bidirectional",
          "enabled"
        ],
        "properties": {
          "channel_id": {
            "enum": [
              "C01",
              "C02",
              "C03",
              "C04",
              "C05",
              "C06"
            ]
          },
          "source": {
            "enum": [
              "N01",
              "N02",
              "N03",
              "N04",
              "N05",
              "N06"
            ]
          },
          "target": {
            "enum": [
              "N01",
              "N02",
              "N03",
              "N04",
              "N05",
              "N06"
            ]
          },
          "length_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bidirectional": {
            "const": true
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "properties": {
              "channel_id": {
                "const": "C01"
              },
              "source": {
                "const": "N01"
              },
              "target": {
                "const": "N02"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C01"
              },
              "source": {
                "const": "N02"
              },
              "target": {
                "const": "N01"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C02"
              },
              "source": {
                "const": "N02"
              },
              "target": {
                "const": "N03"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C02"
              },
              "source": {
                "const": "N03"
              },
              "target": {
                "const": "N02"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C03"
              },
              "source": {
                "const": "N03"
              },
              "target": {
                "const": "N04"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C03"
              },
              "source": {
                "const": "N04"
              },
              "target": {
                "const": "N03"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C04"
              },
              "source": {
                "const": "N04"
              },
              "target": {
                "const": "N05"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C04"
              },
              "source": {
                "const": "N05"
              },
              "target": {
                "const": "N04"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C05"
              },
              "source": {
                "const": "N05"
              },
              "target": {
                "const": "N02"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C05"
              },
              "source": {
                "const": "N02"
              },
              "target": {
                "const": "N05"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C06"
              },
              "source": {
                "const": "N04"
              },
              "target": {
                "const": "N06"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          },
          {
            "properties": {
              "channel_id": {
                "const": "C06"
              },
              "source": {
                "const": "N06"
              },
              "target": {
                "const": "N04"
              },
              "length_m": {
                "const": 2
              },
              "width_m": {
                "const": 0.8
              }
            }
          }
        ]
      }
    }
  }
}
